---
// <Ts t="12:30" /> 또는 <Ts t="1:02:05" />: 누르면 같은 페이지의 <YouTube> 플레이어가 그 시점으로 이동
interface Props { t: string }
const { t } = Astro.props;
const parts = t.split(':').map(Number);
if (parts.some((n) => !Number.isFinite(n)) || parts.length < 2 || parts.length > 3) throw new Error(`<Ts t="${t}">: mm:ss 또는 h:mm:ss`);
const sec = parts.reduce((acc, n) => acc * 60 + n, 0);
---
<button class="yt-ts" type="button" data-t={sec}>{t}</button>
