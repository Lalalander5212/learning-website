---
// 사이트 제목 왼쪽에 사이드바 접기 버튼(데스크톱에서만 보임). 상태는 localStorage('lw-sidebar-collapsed').
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---
<div class="lw-title-row">
  <button class="lw-sidebar-toggle" type="button" aria-controls="starlight__sidebar" aria-expanded="true" aria-label="사이드바 접기" title="사이드바 접기/펴기 (B)">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="M9 4v16" />
      <path class="lw-st-open" d="M15.5 10l-2 2 2 2" />
      <path class="lw-st-closed" d="M13.5 10l2 2-2 2" />
    </svg>
  </button>
  <Default />
</div>
<script>
  import { toggleSidebar, paintSidebarToggle } from '../../lib/ui';
  document.querySelectorAll('.lw-sidebar-toggle').forEach((b) => b.addEventListener('click', toggleSidebar));
  paintSidebarToggle();
</script>
