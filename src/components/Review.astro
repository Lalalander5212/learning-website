---
import { getLessons, url } from '../lib/lessons';
const lessons = (await getLessons()).map(({ id, title, href }) => ({ id, title, href }));
---
<div id="review" class="not-content" data-json={JSON.stringify({ lessons, home: url('') })}>
  <p class="rv-status" id="rv-status">불러오는 중</p>
  <div id="rv-card"></div>
  <div class="rv-actions" id="rv-actions" hidden>
    <button class="lw-btn primary" id="rv-next" type="button">다음 문제</button>
  </div>
</div>
<script>
  import { initReview } from '../lib/review';
  initReview();
</script>
