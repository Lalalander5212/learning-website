---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
const { entry } = Astro.locals.starlightRoute;
const isLesson = !!entry.data.track;
---
<Default><slot /></Default>
{isLesson && (
  <div class="lw-done-wrap">
    <button class="lw-btn" id="lw-done" data-id={entry.id} data-done="false">완료 체크</button>
    {entry.data.est && <span class="lw-meta">⏱ {entry.data.est}</span>}
  </div>
)}
<script>
  import { load, save, idFromPath, today } from './progress';
  function init() {
    const p = load();
    const btn = document.getElementById('lw-done') as HTMLButtonElement | null;
    const paint = () => {
      if (btn) {
        const d = !!p.done[btn.dataset.id!];
        btn.dataset.done = String(d);
        btn.textContent = d ? '✓ 완료함 (취소하려면 클릭)' : '완료 체크';
      }
      document.querySelectorAll<HTMLAnchorElement>('.sidebar-content a[href]').forEach((a) => {
        a.classList.toggle('lw-checked', !!p.done[idFromPath(new URL(a.href).pathname)]);
      });
    };
    btn?.addEventListener('click', () => {
      const id = btn.dataset.id!;
      if (p.done[id]) delete p.done[id]; else p.done[id] = today();
      save(p); paint();
    });
    paint();
  }
  init();
</script>
