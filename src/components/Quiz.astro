---
// <Quiz q="질문" options={['a','b','c']} answer={1} explain="해설" />  (answer는 0부터)
interface Props { q: string; options: string[]; answer: number; explain?: string }
const { q, options, answer, explain } = Astro.props;
---
<div class="quiz not-content" data-answer={answer}>
  <p class="quiz-q">{q}</p>
  <ol class="quiz-opts">
    {options.map((o, i) => (
      <li><button class="quiz-opt" type="button"><kbd>{i + 1}</kbd><span>{o}</span></button></li>
    ))}
  </ol>
  {explain && <p class="quiz-explain" hidden>{explain}</p>}
  <button class="quiz-reset" type="button" hidden>다시 풀기</button>
</div>
